{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sutram Dynamic ERP",
  "version": "2.0.0",
  "identifier": "com.sutram.dynamicerp",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:4300",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sutram Dynamic ERP 2.0 (सूत्रम्)",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
